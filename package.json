{
  "name": "paper-ocean",
  "version": "1.2.3",
  "private": true,
  "author": "Paper Ocean",
  "description": "A local-first paper reader for Windows, macOS and Ubuntu, powered by a ChatGPT Codex subscription.",
  "homepage": "https://github.com/SII-k7/Paper-Ocean#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SII-k7/Paper-Ocean.git"
  },
  "bugs": {
    "url": "https://github.com/SII-k7/Paper-Ocean/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "web": "node scripts/web.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-codex.mjs && node scripts/smoke-paper-services.mjs",
    "smoke:quality": "node scripts/smoke-answer-quality.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "katex": "0.16.22",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "build": {
    "appId": "io.github.siik7.paperocean",
    "productName": "Paper Ocean",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/@napi-rs/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "SII-k7",
      "repo": "Paper-Ocean",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "executableName": "paper-ocean",
      "maintainer": "Paper Ocean <laozhu0626@gmail.com>",
      "artifactName": "Paper-Ocean-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "fonts-noto-cjk"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Paper-Ocean-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Paper-Ocean-${version}-win-${arch}-Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Paper-Ocean-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.education",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Paper Ocean ${version}",
      "sign": false,
      "contents": [
        {
          "x": 140,
          "y": 220,
          "type": "file"
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
